{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-worker",
  "compatibility_date": "2025-11-15",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "im.arusty.dev",
      "custom_domain": true
    }
  ]
}
