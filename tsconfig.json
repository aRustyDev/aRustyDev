{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@data/*": ["./data/*"]
    },
    "resolveJsonModule": true
  },
  "include": ["data/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "site", "build"]
}
